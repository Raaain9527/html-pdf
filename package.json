{
  "name": "html-pdf",
  "version": "1.0.0",
  "description": "Export HTML to single-page vector PDF with selectable text",
  "main": "html2pdf.js",
  "bin": {
    "html2pdf": "./html2pdf.js"
  },
  "scripts": {
    "start": "node html2pdf.js",
    "ui": "node server.js",
    "desktop": "electron electron-main.js",
    "build": "electron-builder --win portable",
    "build:dir": "electron-builder --win dir"
  },
  "build": {
    "appId": "com.html-pdf.app",
    "productName": "HTML to PDF",
    "files": [
      "html2pdf-lib.js",
      "pdf-postprocess.js",
      "electron-main.js",
      "electron-preload.js",
      "ui/**",
      "node_modules/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": null
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "commander": "^15.0.0",
    "electron": "^42.3.2",
    "electron-builder": "^26.8.1",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pdf-lib-plus-encrypt": "^1.1.0",
    "puppeteer": "^25.1.0",
    "puppeteer-core": "^25.1.0"
  }
}
